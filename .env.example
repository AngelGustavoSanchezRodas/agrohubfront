# ==========================================
# AgroHub Frontend - Variables de Entorno
# ==========================================

# 1. Conexion con Firebase Realtime Database
# URL principal de la base de datos en tiempo real de Firebase (con barra diagonal final)
NEXT_PUBLIC_FIREBASE_URL=https://tu-proyecto-firebase-default-rtdb.firebaseio.com/

# URL alternativa de la base de datos de Firebase (sin barra al final)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://tu-proyecto-firebase-default-rtdb.firebaseio.com

# Clave de API web publica de Firebase (Firebase Web API Key)
NEXT_PUBLIC_FIREBASE_API_KEY=tu_firebase_api_key

# Identificador del proyecto de Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu_proyecto_id

# 2. Conexion con el Backend FastAPI (AgroHubBack)
# Ruta base de la API para control de actuadores y consulta de telemetria historica
# - Desarrollo local: http://127.0.0.1:8000
# - Produccion: https://tu-dominio-backend.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Clave de seguridad (API Key) para autorizar acciones protegidas en el backend (Cabecera X-API-Key)
NEXT_PUBLIC_AGROHUB_API_KEY=tu_clave_secreta_api_key